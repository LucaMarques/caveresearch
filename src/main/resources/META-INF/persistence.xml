<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="caveresearchPU" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>br.edu.ifpb.caveresearch.model.embeddable.Endereco</class>
        <class>br.edu.ifpb.caveresearch.model.embeddable.Localizacao</class>
        <class>br.edu.ifpb.caveresearch.model.entity.Amostra</class>
        <class>br.edu.ifpb.caveresearch.model.entity.AutorizacaoAmbiental</class>
        <class>br.edu.ifpb.caveresearch.model.entity.Caverna</class>
        <class>br.edu.ifpb.caveresearch.model.entity.ColetaCientifica</class>
        <class>br.edu.ifpb.caveresearch.model.entity.Equipamento</class>
        <class>br.edu.ifpb.caveresearch.model.entity.Expedicao</class>
        <class>br.edu.ifpb.caveresearch.model.entity.GuiaEspeleologia</class>
        <class>br.edu.ifpb.caveresearch.model.entity.MovimentacaoEquipamento</class>
        <class>br.edu.ifpb.caveresearch.model.entity.ParticipacaoExpedicao</class>
        <class>br.edu.ifpb.caveresearch.model.entity.Pesquisador</class>
        <class>br.edu.ifpb.caveresearch.model.entity.Pessoa</class>
        <class>br.edu.ifpb.caveresearch.model.entity.PlanoSeguranca</class>
        <class>br.edu.ifpb.caveresearch.model.entity.RelatorioFinal</class>
        <class>br.edu.ifpb.caveresearch.model.entity.SetorPesquisa</class>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.transaction.jta.platform" value="org.hibernate.engine.transaction.jta.platform.internal.JBossStandAloneJtaPlatform"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/caveresearch"/>
            <property name="jakarta.persistence.jdbc.user" value="caveresearch"/>
            <property name="jakarta.persistence.jdbc.password" value="caveresearch"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
